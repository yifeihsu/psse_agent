{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerSystemDiagnosticDecision",
  "type": "object",
  "required": [
    "verdict",
    "evidence",
    "suspect_location",
    "action",
    "summary"
  ],
  "properties": {
    "verdict": {
      "type": "object",
      "required": [
        "has_error",
        "error_family",
        "confidence"
      ],
      "properties": {
        "has_error": {
          "type": "boolean"
        },
        "error_family": {
          "type": "string",
          "enum": [
            "measurement_error",
            "parameter_error",
            "topology_error",
            "three_phase_imbalance",
            "harmonic_anomaly",
            "high_impedance_fault",
            "no_error"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "error_families": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "measurement_error",
              "parameter_error",
              "topology_error",
              "three_phase_imbalance",
              "harmonic_anomaly",
              "high_impedance_fault",
              "no_error"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "global_metrics",
        "top_residuals",
        "top_lagrange"
      ],
      "properties": {
        "global_metrics": {
          "type": "object",
          "required": [
            "global_residual_sum",
            "global_residual_threshold",
            "global_residual_ratio"
          ],
          "properties": {
            "global_residual_sum": {
              "type": [
                "number",
                "null"
              ]
            },
            "global_residual_threshold": {
              "type": [
                "number",
                "null"
              ]
            },
            "global_residual_ratio": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "top_residuals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index0",
              "channel",
              "channel_offset",
              "value"
            ],
            "properties": {
              "index0": {
                "type": "integer",
                "minimum": 0
              },
              "channel": {
                "type": "string"
              },
              "channel_offset": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "top_lagrange": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lambda_index0",
              "line_row0",
              "from_bus",
              "to_bus",
              "parameter",
              "value"
            ],
            "properties": {
              "lambda_index0": {
                "type": "integer",
                "minimum": 0
              },
              "line_row0": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "from_bus": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "to_bus": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "parameter": {
                "type": "string",
                "enum": [
                  "R",
                  "X",
                  "unknown"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "top_hif_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rank",
              "branch_row0",
              "line_index1",
              "dss_element",
              "from_bus",
              "to_bus",
              "score"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "branch_row0": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "line_index1": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "dss_element": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "from_bus": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "to_bus": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "hif_parameter_estimate": {
          "type": "object",
          "properties": {
            "alpha_from_from_bus": {
              "type": [
                "number",
                "null"
              ]
            },
            "distance_percent_from_from_bus": {
              "type": [
                "number",
                "null"
              ]
            },
            "phase": {
              "type": [
                "string",
                "null"
              ]
            },
            "r_hif_pu": {
              "type": [
                "number",
                "null"
              ]
            },
            "r_hif_ohm": {
              "type": [
                "number",
                "null"
              ]
            },
            "g_hif_siemens": {
              "type": [
                "number",
                "null"
              ]
            },
            "i_hif_amp": {
              "type": [
                "number",
                "null"
              ]
            },
            "p_hif_kw": {
              "type": [
                "number",
                "null"
              ]
            },
            "q_hif_kvar": {
              "type": [
                "number",
                "null"
              ]
            },
            "localization_certainty": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "well_separated",
                "moderately_separated",
                "ambiguous_top2",
                null
              ]
            },
            "ambiguity": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "weighted_residual_norm": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "suspect_location": {
      "type": "object",
      "required": [
        "domain",
        "details"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "measurement",
            "parameter",
            "topology",
            "harmonic",
            "fault",
            "imbalance",
            "none"
          ]
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "suspect_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain",
          "details"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "enum": [
              "measurement",
              "parameter",
              "topology",
              "harmonic",
              "fault",
              "imbalance",
              "none"
            ]
          },
          "details": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_by_stage": {
      "type": "object"
    },
    "action": {
      "type": "object",
      "required": [
        "applied_tool",
        "arguments_hint",
        "request_more_data",
        "requested_data",
        "verification_summary"
      ],
      "properties": {
        "applied_tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_applied_tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_applied_tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "applied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "arguments_hint": {
          "type": [
            "object",
            "null"
          ]
        },
        "request_more_data": {
          "type": "boolean"
        },
        "requested_data": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "verification_summary": {
          "type": [
            "object",
            "null"
          ]
        },
        "verification_summaries": {
          "type": [
            "object",
            "null"
          ]
        },
        "last_verified_summary": {
          "type": [
            "object",
            "null"
          ]
        },
        "tool_steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "correction_steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "diagnosis_status": {
          "type": "string",
          "enum": [
            "complete",
            "near_threshold",
            "elevated",
            "partial",
            "unknown",
            "not_applicable",
            "curriculum_only",
            "sequence_only"
          ]
        },
        "remaining_candidate_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measurement_correction_policy": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "residual_pattern": {
              "type": "string",
              "enum": [
                "localized",
                "distributed",
                "unknown",
                "not_applicable"
              ]
            },
            "suspect_group_size": {
              "type": "integer",
              "minimum": 0
            },
            "structural_checks_completed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "structural_tools_before_measurement": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "request_more_data": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
