# The supervised pass of the minimal environment (2026-11-15): paths, settings and the job environment, sourced by
# every stage and script of research/hpc/minimal_sft_20261115.  The rows are the truth-built demonstrations executed
# through psse_env/minimal (research/minimal_env/build_demonstrations.py, select_rows.py): six actions, no
# controller, the prompt of psse_env/minimal/observation.py.  No adapter trained before has read that prompt or
# those tools.  A cell of its own, with a source of its own: no other cell's work directory is written to.
WORK=/scratch/yx3882/minimal_sft_20261115
SRC=$WORK/source
CELL=$SRC/research/hpc/minimal_sft_20261115
# The minimal environment's builders, row gate, trainer entry and evaluation, in the same source.
TOOLS=$SRC/research/minimal_env
OUT=$WORK/out
LOGS=$WORK/logs
DATA=$WORK/data
PY=/scratch/yx3882/.conda/envs/gemma4_research_5104/bin/python
HF_HOME=/scratch/yx3882/.cache/huggingface
MODEL_CHOICE=12b
MODEL_ID=google/gemma-4-12B-it

# Where the pass starts.  "r1": the adapter every earlier cloning pass started from (R1 of the conventional cell,
# the bounded cell's copy, read in place).  "base": a new LoRA on the base model, nothing inherited from the rule
# expert's demonstrations.  The pass, its smoke and its evaluation each take the name as SFT_START and keep their
# output apart (out/pass_r1, out/pass_base), so both can be run.
R1_ADAPTER=/scratch/yx3882/compound_cloning_20261106/data/start_adapter
SFT_START_DEFAULT=r1

# The selected rows, uploaded by deploy_from_windows.sh with a manifest (rows_manifest.py).
TRAIN_VIEW=$DATA/rows/train.jsonl
VALIDATION_VIEW=$DATA/rows/validation.jsonl
ROWS_MANIFEST=$DATA/rows/manifest.json

# Training, as the earlier cloning passes: micro-batch 1 x 4 accumulation, so one optimizer step takes four rows.
# Save every 16 steps, validate every 128; SFT_KEEP_* bound the checkpoints on disk.
SFT_LEARNING_RATE=3e-5
SFT_SAVE_STEPS=16
SFT_EVAL_STEPS=128
SFT_KEEP_NEWEST=3
SFT_KEEP_EVERY=$SFT_EVAL_STEPS
SFT_SEED=20261107
# The longest training prompt is about 14,400 tokens by a sibling tokenizer's count, plus about 730 for the tools
# (the row gate counts them with the model's own).  A longer row is refused by the row gate, never cut.  The same
# number is the policy's input limit at evaluation, where an episode can run longer than a demonstration.
TRAIN_MAX_LENGTH=32768
# A fixed name: research-train compares its settings with the saved ones when the adapter is finalized on a
# requeue, so a dated name would fail a pass that crosses midnight.
SFT_RUN_NAME=msf-minimal-sft-20261115
# Size of the smoke inputs (research/minimal_env/row_gate.py: the longest row first).
SMOKE_TRAIN_ROWS=200
SMOKE_VALIDATION_ROWS=32
SMOKE_EVAL_ROOTS=8

# The evaluation: the trained adapter, greedy and in bf16, on the RL series' 300 development cases in the minimal
# environment; the smoke's eight are cut from them by the stage.  The reference file says, per case, whether the
# rule expert's recorded episode and the truth-built sequence repair it (184, 63 more, 53 neither).
DEVELOPMENT_SUITE=/scratch/yx3882/compound_rl_20261107/data/suites/ieee14_dev300.json
SMOKE_SUITE=$DATA/suites/ieee14_dev300_smoke8.json
REFERENCE=$CELL/dev300_reference.json
# What the rows were built with (research/minimal_env/build_demonstrations.py): the adapter reads no other prompt.
EVAL_MAX_ACTIONS=16
EVAL_TABLE_VERSIONS=2

cell_environment() {
  export PATH=/opt/slurm/bin:$PATH
  export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTHONPATH="$SRC"
  export TOKENIZERS_PARALLELISM=false WANDB_MODE=offline
  export HF_HOME HF_HUB_CACHE="$HF_HOME/hub" HF_DATASETS_CACHE="$HF_HOME/datasets" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}" PYTORCH_ALLOC_CONF=expandable_segments:True
  export RESEARCH_MAX_INPUT_TOKENS=$TRAIN_MAX_LENGTH RESEARCH_MAX_NEW_TOKENS=256
  export PSSE_LOCAL_DIAGNOSTIC_BUILD=1
  # Read at import time by modules the audit pulls in; it only has to name a known variant.
  export PSSE_EXPERT_VARIANT=baseline_compare
  unset PSSE_MULTI_SCAN_RCOND
}

# The start named by SFT_START (default SFT_START_DEFAULT): sets START_NAME and START_ARGS, the trainer's
# --initial-adapter for "r1" and nothing for "base".
resolve_start() {
  START_NAME=${SFT_START:-$SFT_START_DEFAULT}
  case "$START_NAME" in
    r1) START_ARGS=(--initial-adapter "$R1_ADAPTER") ;;
    base) START_ARGS=() ;;
    *) echo "SFT_START must be r1 or base, got $START_NAME" >&2; return 2 ;;
  esac
}

# A link of a chain starts when the one before it has ended.  Should a sibling be running anyway (a preemption
# requeue that released the dependency), the later starter leaves: two jobs in one output directory would corrupt
# it.  No squeue on the node: no check.
another_link_running() {
  [[ -n "${SLURM_JOB_ID:-}" && -n "${SLURM_JOB_NAME:-}" ]] || return 1
  command -v squeue >/dev/null 2>&1 || return 1
  local listed
  listed=$(squeue -h -u "${USER:-$(id -un)}" -n "$SLURM_JOB_NAME" -t RUNNING,COMPLETING -o %i 2>/dev/null || true)
  listed=$(grep -vx "$SLURM_JOB_ID" <<<"$listed" || true)
  [[ -n "$listed" ]]
}

# Keep the newest SFT_KEEP_NEWEST checkpoints, every multiple of SFT_KEEP_EVERY and the path in $2 (the one being
# resumed from); remove the rest (research-train has no save limit).
prune_checkpoints() {
  local dir=$1 keep=${2:-} step
  { find "$dir" -maxdepth 1 -type d -name 'checkpoint-*' 2>/dev/null || true; } | sed 's#.*/checkpoint-##' | { grep -E '^[0-9]+$' || true; } \
    | sort -n | head -n "-$SFT_KEEP_NEWEST" | while read -r step; do
      (( step % SFT_KEEP_EVERY == 0 )) && continue
      [[ "checkpoint-$step" == "${keep##*/}" ]] && continue
      rm -rf "${dir:?}/checkpoint-$step"
    done
  return 0
}
