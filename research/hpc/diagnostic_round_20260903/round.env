# Shared settings for the 2026-09-03 diagnostic-family research round.
#
# Sourced by every stage script on the cluster.  Keep it plain assignments
# plus two helper functions so `bash -n` and the repository tests can parse it
# without the cluster environment.
ROUND=/scratch/yx3882/research_diag_round_20260903
SRC=$ROUND/source
OUT=$ROUND/out
LOGS=$ROUND/logs
PY=/scratch/yx3882/.conda/envs/gemma4_research_5104/bin/python
# The research environment carries no pytest.  The CPU test files this round
# runs before collection import only numpy/scipy/pypower/OpenDSS code, whose
# versions are identical in the exposure-cell overlay, so that interpreter
# runs them.
TEST_PY=/scratch/yx3882/envs/dagger12b_overlay/bin/python
EXPECTED_SOURCE_COMMIT_FILE=$ROUND/source_commit.txt

# Round-0 release aggregate (internally certified by its SHA256SUMS file).
D0_ROOT=/scratch/yx3882/dagger_release_a5a7574_20260823/round0_aggregate_release
D0_RAW=$D0_ROOT/aggregate.raw.jsonl
D0_TRAIN=$D0_ROOT/aggregate.train_view.jsonl
D0_RAW_SHA256=614cf1c035963a90f216673515c8f1357d5ac95577ec40641a5ed8b85a7c66ed
D0_TRAIN_SHA256=28b733db96c6ce05dbdc8d43484bdbb14445e1105958a78f9a35024aa5b3844a
# 27-row classical-family trace validation: protected roots plus the
# training-loss monitor.  Explanation-only families have no loss set of their
# own yet; the paired closed-loop evaluation on the diagnostic development
# roots is the outcome measure, not this loss.
VALIDATION=/scratch/yx3882/research_dagger_trace_20260823/trace_validation.jsonl
VALIDATION_SHA256=f05b944f89fa03f61c11376bd05da513f21a7b747c66bfdf80ab11908290898e
PROTECTED_D1=/scratch/yx3882/research_gemma4_small_20260824_fe94580/evaluation/bc0_12b_replay_compare_v2/published_replay/d1_development_suite.json
PROTECTED_D1_SHA256=dafe9925dedacc1aaeb861f7a6891a4bdc1ce2a3be4b13d7ba999275a505124d
# Student for collection, paired baseline for evaluation, and warm start for
# training: the BC0 12B checkpoint trained on google/gemma-4-12B-it.
WARM_START=/scratch/yx3882/research_gemma4_small_20260824_fe94580/bc0/full/checkpoint-192
BC0_SUITE=$SRC/psse_env/dagger/suites/bc0_eval_suite_v1.json

MODEL_CHOICE=12b
MODEL_ID=google/gemma-4-12B-it
MODEL_REVISION=707f0a3b8a3c7ad586ed01e27eafbad8a27dd0f7
HF_HOME=/scratch/yx3882/.cache/huggingface

COLLECTION_DIR=$OUT/collection
TRAIN_DIR=$OUT/training
CANDIDATE=$TRAIN_DIR/lora
SEED=20260903
PLAN_PRESET=diagnostic
# Optional JSON plans (family -> root count) that replace the preset's
# training and development plans; empty keeps the preset.  A round directory
# may carry them in round.overrides.env (see the end of this file).
TRAIN_PLAN=""
DEVELOPMENT_PLAN=""
COLLECTION_BETA=0.25
COLLECTION_MAX_STEPS=12
CANDIDATE_MULTIPLIER=3
D1_CAP=200
D1_SHARE=0.5
EVAL_MAX_STEPS=24
TRAIN_SAVE_EVAL_STEPS=16
TRAIN_LEARNING_RATE=3e-5
TRAIN_MAX_LENGTH=32768
TRAIN_RUN_NAME=research-diag-round-20260903
# D0 families removed from the mixture's D0 pool before sampling: their
# voltage-only HIF episodes were all taught to end in an operator handoff,
# which contradicts the diagnostic D1 rows.  The count is asserted so a
# different D0 view cannot pass silently (49 hif + 42 measurement+hif).
STALE_D0_FAMILIES="hif,measurement+hif"
EXPECTED_STALE_D0_ROWS=91

round_environment() {
  export PYTHONDONTWRITEBYTECODE=1
  export PYTHONNOUSERSITE=1
  export PYTHONUNBUFFERED=1
  export PYTHONPATH="$SRC"
  export TOKENIZERS_PARALLELISM=false
  export WANDB_MODE=offline
  export HF_HOME
  export HF_HUB_CACHE="$HF_HOME/hub"
  export HF_DATASETS_CACHE="$HF_HOME/datasets"
  export HF_HUB_OFFLINE=1
  export TRANSFORMERS_OFFLINE=1
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
  export PYTORCH_ALLOC_CONF=expandable_segments:True
  # The research policy loader reads these; the 12B baseline was measured at
  # this input budget and the launcher for round 1 exported the same values.
  export RESEARCH_MAX_INPUT_TOKENS=32768
  export RESEARCH_MAX_NEW_TOKENS=256
}

# The exact research-script invocation.  Collection and paired evaluation must
# pass identical arguments (the script binds them into its resumable config);
# evaluation only appends --eval-r1-adapter.
collection_args() {
  COLLECTION_ARGS=(
    --d0-raw "$D0_RAW"
    --d0-train "$D0_TRAIN"
    --protected-suite "$VALIDATION"
    --protected-suite "$PROTECTED_D1"
    --protected-suite "$BC0_SUITE"
    --adapter-path "$WARM_START"
    --output-dir "$COLLECTION_DIR"
    --model-choice "$MODEL_CHOICE"
    --seed "$SEED"
    --beta "$COLLECTION_BETA"
    --max-steps "$COLLECTION_MAX_STEPS"
    --d1-cap "$D1_CAP"
    --d1-share "$D1_SHARE"
    --candidate-multiplier "$CANDIDATE_MULTIPLIER"
    --plan-preset "$PLAN_PRESET"
    --hif-search-profile auto
    --eval-max-steps "$EVAL_MAX_STEPS"
  )
  if [[ -n "$TRAIN_PLAN" ]]; then
    COLLECTION_ARGS+=(--train-plan "$TRAIN_PLAN")
  fi
  if [[ -n "$DEVELOPMENT_PLAN" ]]; then
    COLLECTION_ARGS+=(--development-plan "$DEVELOPMENT_PLAN")
  fi
}

# Per-round overrides staged by deploy_remote.sh (plan sizes, mixture cap,
# run name).  Sourced last so they win over the defaults above.
if [[ -f "$ROUND/round.overrides.env" ]]; then
  # shellcheck source=/dev/null
  source "$ROUND/round.overrides.env"
fi
