# Complete-evidence clone (2026-11-15): paths, settings and the job environment, sourced by every stage and script
# of research/hpc/clone_complete_evidence_20261115.  The pass is the cloning pass of 2026-11-06
# (research/hpc/compound_cloning_20261106), which made S0, on the rows of the complete-evidence selection: the same
# start adapter and every trainer setting of that pass.  The rows show the estimator's output whole and none of the
# rule screens' conclusions (psse_env/providers/complete_evidence.py), so no adapter trained before can read them
# and the pass starts where S0's and the open-rules clone's did.  A cell of its own, with a source of its own: the
# open-rules clone's cell (/scratch/yx3882/clone_open_rules_20261112) and the RL series' are not moved.
WORK=/scratch/yx3882/clone_complete_evidence_20261115
SRC=$WORK/source
CELL=$SRC/research/hpc/clone_complete_evidence_20261115
# The bounded pass's cell in the same source: its trainer entry, row gate and smoke inputs are used as they are.
BOUNDED_CELL=$SRC/research/hpc/compound_cloning_20261106
OUT=$WORK/out
LOGS=$WORK/logs
DATA=$WORK/data
CONFIG_DIR=$WORK/configs
PY=/scratch/yx3882/.conda/envs/gemma4_research_5104/bin/python
HF_HOME=/scratch/yx3882/.cache/huggingface
MODEL_CHOICE=12b
MODEL_ID=google/gemma-4-12B-it

# Start adapter: the one S0's pass started from (R1 of the conventional cell, the copy that pass's cell made), read
# in place.  The clone and S0 differ in their rows and in nothing before them.
START_ADAPTER=/scratch/yx3882/compound_cloning_20261106/data/start_adapter
CLONED_ADAPTER=$OUT/clone/training/lora
# S0, read by the baseline smoke only: the smoke tries the driver in this environment before the pass has an
# adapter.  S0 was trained on another prompt, so what it solves there says nothing; the smoke is read for prompt
# length, memory and refusals.
S0_ADAPTER=/scratch/yx3882/compound_cloning_20261106/out/clone/training/lora

# The selected rows, uploaded by deploy_from_windows.sh with a manifest (rows_manifest.py).
TRAIN_VIEW=$DATA/rows/selection.train_view.jsonl
VALIDATION_VIEW=$DATA/rows/selection.validation.jsonl
ROWS_MANIFEST=$DATA/rows/manifest.json

# Training, as the bounded pass: micro-batch 1 x 4 accumulation, so one optimizer step takes four rows.  Save every
# 16 steps, validate every 128; CLONE_KEEP_* bound the checkpoints on disk.
CLONE_LEARNING_RATE=3e-5
CLONE_SAVE_STEPS=16
CLONE_EVAL_STEPS=128
CLONE_KEEP_NEWEST=3
CLONE_KEEP_EVERY=$CLONE_EVAL_STEPS
CLONE_SEED=20261107
# The longest row is about 46,400 characters with its tools, about 20,700 tokens by a sibling tokenizer's count
# (the row gate counts them with the model's own); the bounded pass's limit holds it.  A longer row is refused by
# the row gate, never cut.
TRAIN_MAX_LENGTH=32768
# A fixed name: research-train compares its settings with the saved ones when the adapter is finalized on a
# requeue, so a dated name would fail a pass that crosses midnight.
CLONE_RUN_NAME=cc-clone-complete-evidence-20261115
# The run-time tool list of every row, as the bounded pass rendered them (its README, "Decision").
CLONE_TOOLS=runtime
# Size of the smoke inputs (the bounded cell's smoke_inputs.py: the longest row first).
SMOKE_TRAIN_ROWS=200
SMOKE_VALIDATION_ROWS=32
SMOKE_EVAL_ROOTS=8

# The baselines: the RL driver's baseline phase from configs/baseline_NAME.json (baseline_config.py), on the RL
# series' 300 development cases; the smoke's eight are cut from them by the stage.
DEVELOPMENT_SUITE=/scratch/yx3882/compound_rl_20261107/data/suites/ieee14_dev300.json
SMOKE_SUITE=$DATA/suites/ieee14_dev300_smoke8.json
# What the clone's baseline is read against (status_cell.sh), each read in place: S0 with the rules in place
# (arm A of the RL series), and S0 and the open-rules clone with the rules lifted (the open-rules clone's cell).
ARM_A_BASELINE=/scratch/yx3882/rl_improvement_20261110/out/arm_a_bounded/baseline/evaluation.json
OPEN_CELL_OUT=/scratch/yx3882/clone_open_rules_20261112/out

cell_environment() {
  export PATH=/opt/slurm/bin:$PATH
  export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTHONPATH="$SRC"
  export TOKENIZERS_PARALLELISM=false WANDB_MODE=offline
  export HF_HOME HF_HUB_CACHE="$HF_HOME/hub" HF_DATASETS_CACHE="$HF_HOME/datasets" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}" PYTORCH_ALLOC_CONF=expandable_segments:True
  export RESEARCH_MAX_INPUT_TOKENS=$TRAIN_MAX_LENGTH RESEARCH_MAX_NEW_TOKENS=256
  export PSSE_HIF_WORKERS="${SLURM_CPUS_PER_TASK:-8}" PSSE_LOCAL_DIAGNOSTIC_BUILD=1
  # The configs name the teacher variant and every environment option; this variable only has to name a known
  # variant for the modules that read it at import time (as in the RL series' rl.sbatch).
  export PSSE_EXPERT_VARIANT=baseline_compare
  unset PSSE_MULTI_SCAN_RCOND
}

# A link of a chain starts when the one before it has ended.  Should a sibling be running anyway (a preemption
# requeue that released the dependency), the later starter leaves: two jobs in one output directory would corrupt
# it.  No squeue on the node: no check.
another_link_running() {
  [[ -n "${SLURM_JOB_ID:-}" && -n "${SLURM_JOB_NAME:-}" ]] || return 1
  command -v squeue >/dev/null 2>&1 || return 1
  local listed
  listed=$(squeue -h -u "${USER:-$(id -un)}" -n "$SLURM_JOB_NAME" -t RUNNING,COMPLETING -o %i 2>/dev/null || true)
  listed=$(grep -vx "$SLURM_JOB_ID" <<<"$listed" || true)
  [[ -n "$listed" ]]
}

# Keep the newest CLONE_KEEP_NEWEST checkpoints, every multiple of CLONE_KEEP_EVERY and the path in $2 (the one
# being resumed from); remove the rest (research-train has no save limit).
prune_checkpoints() {
  local dir=$1 keep=${2:-} step
  { find "$dir" -maxdepth 1 -type d -name 'checkpoint-*' 2>/dev/null || true; } | sed 's#.*/checkpoint-##' | { grep -E '^[0-9]+$' || true; } \
    | sort -n | head -n "-$CLONE_KEEP_NEWEST" | while read -r step; do
      (( step % CLONE_KEEP_EVERY == 0 )) && continue
      [[ "checkpoint-$step" == "${keep##*/}" ]] && continue
      rm -rf "${dir:?}/checkpoint-$step"
    done
  return 0
}
