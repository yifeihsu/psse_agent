# The RL plan of 2026-11-22 for the minimal environment (docs/minimal_rl_plan_20261122.md): paths and the job
# environment, sourced by the stages and every script of research/hpc/minimal_rl_20261122.  Two runs of the driver
# (research/minimal_env/rl_train.py) and one probe:
#
#   steps  stage A: the focused run's procedure with eight optimizer steps a batch (rl_steps.json).
#   forks  stage B: the same, with the one-step forks of the greedy episode and without the truth-built examples
#          (rl_forks.json).
#   probe  the forks alone, with no update: how many unrepaired cases one forced step repairs
#          (research/minimal_env/fork_probe.py).
#
# What a run does is in its config; nothing here changes it.  A cell of its own, with a source of its own: no other
# cell's work directory is written to.
WORK=/scratch/yx3882/minimal_rl_20261122
SRC=$WORK/source
CELL=$SRC/research/hpc/minimal_rl_20261122
OUT=$WORK/out
LOGS=$WORK/logs
PY=/scratch/yx3882/.conda/envs/gemma4_research_5104/bin/python
HF_HOME=/scratch/yx3882/.cache/huggingface

# The supervised pass (research/hpc/minimal_sft_20261115), read in place and never written to: its adapter is where
# every run starts and the reference of its KL penalty; its evaluation on the 300 development cases is every run's
# baseline and names the development cases the probe forks.
PASS=/scratch/yx3882/minimal_sft_20261115/out/pass_base
PASS_ADAPTER=$PASS/training/lora
DEV_PASS=/scratch/yx3882/minimal_sft_20261115/out/eval_dev300_base
# The earlier RL cell (research/hpc/minimal_rl_20261116), read in place and never written to: the supervised
# model's greedy pass over the training cases a truth-built sequence repairs, which the runs draw by.
TRAIN_PASS=/scratch/yx3882/minimal_rl_20261116/out/train_pass
# In this cell's own source.
TRUTH_SEQUENCES=$SRC/research/hpc/minimal_rl_20261116/train_truth_sequences.json
DEV_REFERENCE=$SRC/research/hpc/minimal_sft_20261115/dev300_reference.json
TRAIN_SUITE=/scratch/yx3882/compound_rl_20261107/data/suites/ieee14_train.json
DEV_SUITE=/scratch/yx3882/compound_rl_20261107/data/suites/ieee14_dev300.json
MODEL_CHOICE=12b
RL_MAX_ACTIONS=16
RL_TABLE_VERSIONS=2

# The policy's input limit, the supervised cell's: a prompt over it is refused, never cut.
RL_MAX_INPUT_TOKENS=32768
RL_MAX_NEW_TOKENS=256
# Two processes share a card from this much memory in the rollout, the forks and the evaluations; the update is
# always one process.
RL_TWO_WORKERS_FROM_MIB=70000

# The probe: every unrepaired development case a truth-built sequence repairs (49), and a seeded sample of the
# unrepaired training cases (502).  The smoke forks four development cases, with one sampled call a tool.
PROBE_TRAIN_SAMPLE=100
PROBE_SMOKE_SAMPLE=4
PROBE_SEED=20261122

cell_environment() {
  export PATH=/opt/slurm/bin:$PATH
  export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTHONPATH="$SRC"
  export TOKENIZERS_PARALLELISM=false WANDB_MODE=offline
  export HF_HOME HF_HUB_CACHE="$HF_HOME/hub" HF_DATASETS_CACHE="$HF_HOME/datasets" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}" PYTORCH_ALLOC_CONF=expandable_segments:True
  export RESEARCH_MAX_INPUT_TOKENS=$RL_MAX_INPUT_TOKENS RESEARCH_MAX_NEW_TOKENS=$RL_MAX_NEW_TOKENS
  export PSSE_LOCAL_DIAGNOSTIC_BUILD=1
  # Read at import time by modules the audit pulls in; it only has to name a known variant.
  export PSSE_EXPERT_VARIANT=baseline_compare
  unset PSSE_MULTI_SCAN_RCOND
}

# A link of a chain starts when the one before it has ended.  Should a sibling be running anyway (a preemption
# requeue that released the dependency), the later starter leaves: two jobs in one run directory would corrupt it.
# No squeue on the node: no check.
another_link_running() {
  [[ -n "${SLURM_JOB_ID:-}" && -n "${SLURM_JOB_NAME:-}" ]] || return 1
  command -v squeue >/dev/null 2>&1 || return 1
  local listed
  listed=$(squeue -h -u "${USER:-$(id -un)}" -n "$SLURM_JOB_NAME" -t RUNNING,COMPLETING -o %i 2>/dev/null || true)
  listed=$(grep -vx "$SLURM_JOB_ID" <<<"$listed" || true)
  [[ -n "$listed" ]]
}
