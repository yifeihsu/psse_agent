# Cloning-pass cell (2026-11-06): paths, settings and the job environment, sourced by every stage
# and script of research/hpc/compound_cloning_20261106.  Nothing here depends on how many rows the
# pass has: the stage reads the optimizer step count from the row file at run time.
WORK=/scratch/yx3882/compound_cloning_20261106
SRC=$WORK/source
CELL=$SRC/research/hpc/compound_cloning_20261106
OUT=$WORK/out
LOGS=$WORK/logs
DATA=$WORK/data
EVAL_OUT=$OUT/eval
# Per-system report files for evaluate_suite.py --cell-dir (env_report.py).
ENV_DIR=$OUT/env
PY=/scratch/yx3882/.conda/envs/gemma4_research_5104/bin/python
HF_HOME=/scratch/yx3882/.cache/huggingface
MODEL_CHOICE=12b
MODEL_ID=google/gemma-4-12B-it

# Start adapter: R1 of the conventional cell, copied once into this cell by remote_prepare.sh
# (regular files, so checkpoint_tree_sha256 accepts them however the original is linked).
CONVENTIONAL_CELL=/scratch/yx3882/research_full_pipeline_20261022_conventional
START_ADAPTER_SOURCE=$CONVENTIONAL_CELL/out/r1/training/lora
START_ADAPTER=$DATA/start_adapter
CLONED_ADAPTER=$OUT/clone/training/lora

# The selected rows, uploaded by deploy_from_windows.sh.
TRAIN_VIEW=$DATA/rows/cloning.train_view.jsonl
VALIDATION_VIEW=$DATA/rows/cloning.validation.jsonl
ROWS_MANIFEST=$DATA/rows/manifest.json

# Training (micro-batch 1 x 4 accumulation, so one optimizer step takes four rows).  Save every 16
# steps, validate every 128 (README, "Cadence").  CLONE_KEEP_* bound the checkpoints on disk: the
# newest ones and those at validation points stay; CLONE_KEEP_EVERY=$CLONE_SAVE_STEPS keeps all.
CLONE_LEARNING_RATE=3e-5
CLONE_SAVE_STEPS=16
CLONE_EVAL_STEPS=128
CLONE_KEEP_NEWEST=3
CLONE_KEEP_EVERY=$CLONE_EVAL_STEPS
CLONE_SEED=20261107
TRAIN_MAX_LENGTH=32768
# A fixed name: research-train compares its settings with the saved ones when the adapter is
# finalized on a requeue, so a dated name would fail a pass that crosses midnight.
CLONE_RUN_NAME=cc-clone-20261106
# Which tool list the rows are rendered with.  runtime: each row's run-time list (13 tools under
# scada_only, the rollback description that allows a decline; train_runtime_tools.py).  registry:
# the stock command, which renders all 20 tools and the plain description (README, "Decision").
CLONE_TOOLS=runtime
# Size of the smoke inputs (smoke_inputs.py).
SMOKE_TRAIN_ROWS=200
SMOKE_VALIDATION_ROWS=32
SMOKE_EVAL_ROOTS=8

# Evaluation.  The seeds keep the episodes paired with their references: 20261006 is the compound
# rollouts' default (research/compound_errors/rollout.py), 20260912 the conventional cell's
# SEED_ROUND.  The list of suites is eval_suites.env; a suite's system is read from its roots.
EVAL_MAX_STEPS=40
SEED_COMPOUND=20261006
SEED_CONVENTIONAL=20260912
CONVENTIONAL_TEST_SUITE=$CONVENTIONAL_CELL/out/r1/collection/development_scenarios.json

cell_environment() {
  export PATH=/opt/slurm/bin:$PATH
  export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTHONPATH="$SRC"
  export TOKENIZERS_PARALLELISM=false WANDB_MODE=offline
  export HF_HOME HF_HUB_CACHE="$HF_HOME/hub" HF_DATASETS_CACHE="$HF_HOME/datasets" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}" PYTORCH_ALLOC_CONF=expandable_segments:True
  export RESEARCH_MAX_INPUT_TOKENS=32768 RESEARCH_MAX_NEW_TOKENS=256
  export PSSE_HIF_WORKERS="${SLURM_CPUS_PER_TASK:-8}" PSSE_LOCAL_DIAGNOSTIC_BUILD=1
  # The student needs no teacher.  evaluate_suite.py still requires this variable to equal the
  # teacher its report names (env_report.py EXPERT_VARIANT), and a teacher variant can switch
  # environment options on, so the report names those options explicitly.
  export PSSE_EXPERT_VARIANT=baseline_compare
}

# A link of a chain starts when the one before it has ended.  Should a sibling be running anyway
# (a preemption requeue that released the dependency), the later starter leaves: two trainers in
# one output directory would corrupt it.  No squeue on the node: no check.
another_link_running() {
  [[ -n "${SLURM_JOB_ID:-}" && -n "${SLURM_JOB_NAME:-}" ]] || return 1
  command -v squeue >/dev/null 2>&1 || return 1
  local listed
  listed=$(squeue -h -u "${USER:-$(id -un)}" -n "$SLURM_JOB_NAME" -t RUNNING,COMPLETING -o %i 2>/dev/null || true)
  listed=$(grep -vx "$SLURM_JOB_ID" <<<"$listed" || true)
  [[ -n "$listed" ]]
}

# Keep the newest CLONE_KEEP_NEWEST checkpoints, every multiple of CLONE_KEEP_EVERY and the path in
# $2 (the one being resumed from); remove the rest.  research-train has no save limit, and a pass
# saving every 16 steps writes on the order of 100 to 200 GB otherwise (README).
prune_checkpoints() {
  local dir=$1 keep=${2:-} step
  { find "$dir" -maxdepth 1 -type d -name 'checkpoint-*' 2>/dev/null || true; } | sed 's#.*/checkpoint-##' | { grep -E '^[0-9]+$' || true; } \
    | sort -n | head -n "-$CLONE_KEEP_NEWEST" | while read -r step; do
      (( step % CLONE_KEEP_EVERY == 0 )) && continue
      [[ "checkpoint-$step" == "${keep##*/}" ]] && continue
      rm -rf "${dir:?}/checkpoint-$step"
    done
  return 0
}
