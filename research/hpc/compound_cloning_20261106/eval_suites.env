# The evaluation suites of the cloning cell, one line each, sourced by submit_cell.sh after cell.env:
#
#   eval_suite NAME SUITE_FILE SEED LINKS
#
# Results go to $OUT/eval/NAME_before and NAME_after.  LINKS is the number of 12-hour jobs in the
# suite's chain (README); a link with nothing left to do exits at once.  A suite's system is read
# from its roots at job start, and the progress basis and the conditioning guard follow it
# (env_report.py), so no line names a system and no stage names a suite.
#
# deploy_from_windows.sh uploads the working copy of this file to $DATA/eval_suites.env (no commit
# needed for a change here), and the suite files named in UPLOAD_SUITES to $DATA/suites/NAME.json.
# submit_cell.sh takes the names to run as arguments and defaults to every line.
eval_suite ieee14_dev        "$DATA/suites/ieee14_dev.json" "$SEED_COMPOUND"     3
eval_suite conventional_test "$CONVENTIONAL_TEST_SUITE"     "$SEED_CONVENTIONAL" 1

# The IEEE 118 development draws stay out of the default list.  To add them: uncomment these lines,
# run deploy_from_windows.sh with DEPLOY_ROWS=0 and UPLOAD_SUITES naming their files (README), then
# submit_cell.sh before ieee118_draw1 ieee118_draw2 (and after).  No stage changes.
# eval_suite ieee118_draw1 "$DATA/suites/ieee118_draw1.json" "$SEED_COMPOUND" 2
# eval_suite ieee118_draw2 "$DATA/suites/ieee118_draw2.json" "$SEED_COMPOUND" 2
