# The stopping-state diagnostic of the supervised model (2026-11-20): the probability it gives, at the state where
# each of its unrepaired episodes stopped, to its own last action and to the first actions of the truth-built
# continuation from there (research/minimal_env/score_actions.py, on the states research/minimal_env/stopping_states.py
# replayed locally).  A cell of its own, with a source of its own: the RL cell's source is cloned from and never
# moved, because the focused run's jobs read it at every phase.  Nothing here trains or evaluates.
WORK=/scratch/yx3882/minimal_diag_20261120
SRC=$WORK/source
CELL=$SRC/research/hpc/minimal_diag_20261120
OUT=$WORK/out
LOGS=$WORK/logs
DATA=$WORK/data
PY=/scratch/yx3882/.conda/envs/gemma4_research_5104/bin/python
HF_HOME=/scratch/yx3882/.cache/huggingface

# The supervised pass (research/hpc/minimal_sft_20261115), read in place and never written to: its adapter is the
# model whose stopping states are scored, the one the focused RL run starts from.
PASS=/scratch/yx3882/minimal_sft_20261115/out/pass_base
PASS_ADAPTER=$PASS/training/lora

# The states, as stopping_states.py wrote them on Windows; deploy_from_windows.sh uploads them with their checksums
# verified.  One line per stopping state of an unrepaired episode, with the observation the model read there.
INPUTS_DEV=$DATA/scoring_inputs_dev.jsonl
INPUTS_TRAIN=$DATA/scoring_inputs_train.jsonl
SCORES=$OUT/scores
MODEL_CHOICE=12b
# The episode and the limits the supervised pass's evaluations ran under (research/hpc/minimal_sft_20261115).
DG_MAX_ACTIONS=16
DG_TABLE_VERSIONS=2
DG_MAX_INPUT_TOKENS=32768
DG_MAX_LENGTH=32768
DG_MAX_NEW_TOKENS=256
# Two processes share a card from this much memory, as in the RL cell's evaluations.
DG_TWO_WORKERS_FROM_MIB=70000

cell_environment() {
  export PATH=/opt/slurm/bin:$PATH
  export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTHONPATH="$SRC"
  export TOKENIZERS_PARALLELISM=false WANDB_MODE=offline
  export HF_HOME HF_HUB_CACHE="$HF_HOME/hub" HF_DATASETS_CACHE="$HF_HOME/datasets" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}" PYTORCH_ALLOC_CONF=expandable_segments:True
  export RESEARCH_MAX_INPUT_TOKENS=$DG_MAX_INPUT_TOKENS RESEARCH_MAX_NEW_TOKENS=$DG_MAX_NEW_TOKENS
  export PSSE_LOCAL_DIAGNOSTIC_BUILD=1
  # Read at import time by modules the audit pulls in; it only has to name a known variant.
  export PSSE_EXPERT_VARIANT=baseline_compare
  unset PSSE_MULTI_SCAN_RCOND
}
