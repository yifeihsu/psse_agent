# The RL run of the minimal environment (2026-11-16): paths and the job environment, sourced by the stage and every
# script of research/hpc/minimal_rl_20261116.  The driver is research/minimal_env/rl_train.py: sampled episodes of
# psse_env/minimal, the outcome reward, one on-policy update per iteration with a KL penalty to the supervised
# model, and the greedy evaluation on the 300 development cases.  What a run does is in its config (rl_ieee14.json,
# rl_smoke.json); nothing here changes it.  A cell of its own, with a source of its own: no other cell's work
# directory is written to.
WORK=/scratch/yx3882/minimal_rl_20261116
SRC=$WORK/source
CELL=$SRC/research/hpc/minimal_rl_20261116
OUT=$WORK/out
LOGS=$WORK/logs
DATA=$WORK/data
PY=/scratch/yx3882/.conda/envs/gemma4_research_5104/bin/python
HF_HOME=/scratch/yx3882/.cache/huggingface

# The supervised pass (research/hpc/minimal_sft_20261115), read in place and never written to.  Its adapter is
# where the run starts and the reference of its KL penalty; its evaluation on the 300 development cases, once
# finished, is the run's baseline (rl_ieee14.json, baseline_from).
PASS=/scratch/yx3882/minimal_sft_20261115/out/pass_base
PASS_ADAPTER=$PASS/training/lora
# The smoke's starting adapter: the cell's own copy of the pass's adapter or, while the pass is running, of its
# newest complete checkpoint.  A copy, because the pass removes old checkpoints as it goes.
SMOKE_ADAPTER=$DATA/smoke_adapter

# The focused run (rl_focus.json, rl_focus_smoke.json; README.md, "The focused run"): it draws from the training
# cases a truth-built sequence repairs and the supervised model does not.  The sequences are in the source; which
# of their cases the supervised model repairs is read from its greedy pass over them (stage_train_pass.sbatch),
# made under the episode and the limits the configs name.
TRUTH_SEQUENCES=$CELL/train_truth_sequences.json
TRAIN_SUITE=/scratch/yx3882/compound_rl_20261107/data/suites/ieee14_train.json
TRAIN_PASS=$OUT/train_pass
MODEL_CHOICE=12b
RL_MAX_ACTIONS=16
RL_TABLE_VERSIONS=2

# The policy's input limit, the supervised cell's: a prompt over it is refused, never cut.  With the tables of two
# versions shown a prompt stops growing near 15,500 tokens (the supervised cell's evaluation smoke).
RL_MAX_INPUT_TOKENS=32768
RL_MAX_NEW_TOKENS=256
# Two processes share a card from this much memory in the rollout and the evaluations (they peaked at 67.7 GB
# together in the supervised cell's evaluation smoke); the update is always one process.
RL_TWO_WORKERS_FROM_MIB=70000

cell_environment() {
  export PATH=/opt/slurm/bin:$PATH
  export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTHONPATH="$SRC"
  export TOKENIZERS_PARALLELISM=false WANDB_MODE=offline
  export HF_HOME HF_HUB_CACHE="$HF_HOME/hub" HF_DATASETS_CACHE="$HF_HOME/datasets" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}" PYTORCH_ALLOC_CONF=expandable_segments:True
  export RESEARCH_MAX_INPUT_TOKENS=$RL_MAX_INPUT_TOKENS RESEARCH_MAX_NEW_TOKENS=$RL_MAX_NEW_TOKENS
  export PSSE_LOCAL_DIAGNOSTIC_BUILD=1
  # Read at import time by modules the audit pulls in; it only has to name a known variant.
  export PSSE_EXPERT_VARIANT=baseline_compare
  unset PSSE_MULTI_SCAN_RCOND
}

# A link of a chain starts when the one before it has ended.  Should a sibling be running anyway (a preemption
# requeue that released the dependency), the later starter leaves: two jobs in one run directory would corrupt it.
# No squeue on the node: no check.
another_link_running() {
  [[ -n "${SLURM_JOB_ID:-}" && -n "${SLURM_JOB_NAME:-}" ]] || return 1
  command -v squeue >/dev/null 2>&1 || return 1
  local listed
  listed=$(squeue -h -u "${USER:-$(id -un)}" -n "$SLURM_JOB_NAME" -t RUNNING,COMPLETING -o %i 2>/dev/null || true)
  listed=$(grep -vx "$SLURM_JOB_ID" <<<"$listed" || true)
  [[ -n "$listed" ]]
}

# The newest checkpoint of the pass that was written whole (the trainer writes trainer_state.json last); empty
# when there is none.
newest_complete_checkpoint() {
  local step
  { find "$PASS/training" -maxdepth 1 -type d -name 'checkpoint-*' 2>/dev/null || true; } | sed 's#.*/checkpoint-##' \
    | { grep -E '^[0-9]+$' || true; } | sort -rn | while read -r step; do
      if [[ -s "$PASS/training/checkpoint-$step/trainer_state.json" && -s "$PASS/training/checkpoint-$step/adapter_model.safetensors" ]]; then
        echo "$PASS/training/checkpoint-$step"
        break
      fi
    done
}
