# The candidate read-out (2026-11-25): at the state where each unrepaired episode of a model's greedy development
# evaluation stopped, the exact top of that model's next-call distribution over the corrections it could write there
# (research/minimal_env/candidate_sets.py), and whether the objects still wrong are among the 1, 3 and 5 most
# probable.  A cell of its own, with a source of its own: the RL cell's source is cloned from and never moved.
# Nothing here trains or evaluates.
WORK=/scratch/yx3882/minimal_candidates_20261125
SRC=$WORK/source
CELL=$SRC/research/hpc/minimal_candidates_20261125
OUT=$WORK/out
LOGS=$WORK/logs
DATA=$WORK/data
PY=/scratch/yx3882/.conda/envs/gemma4_research_5104/bin/python
HF_HOME=/scratch/yx3882/.cache/huggingface

# The models, read in place and never written to.  An arm is a model with the stopping states of its own greedy
# evaluation of the 300 development cases:
#   base     the supervised pass's adapter (research/hpc/minimal_sft_20261115), every RL run's start: 198 of the 247;
#   steps17  stage A's adapter after 17 optimizer steps (research/hpc/minimal_rl_20261122, iteration 2): 205 of the 247.
PASS=/scratch/yx3882/minimal_sft_20261115/out/pass_base
STEPS=/scratch/yx3882/minimal_rl_20261122/out/steps
ARMS="base steps17"
arm_adapter() {
  case "$1" in
    base) echo "$PASS/training/lora" ;;
    steps17) echo "$STEPS/iteration_002/adapter" ;;
    *) echo "unknown arm '$1' (one of: $ARMS)" >&2; return 2 ;;
  esac
}
# The states of an arm, as candidate_sets.py build wrote them on Windows; deploy_from_windows.sh uploads them with
# their checksums verified.  One line per stopping state, with the observation the model read there.
arm_inputs() { echo "$DATA/candidate_inputs_dev_$1.jsonl"; }
arm_scores() { echo "$OUT/$1"; }
MODEL_CHOICE=12b
# The episode and the limits the evaluations ran under (research/hpc/minimal_sft_20261115, minimal_rl_20261122).
CS_MAX_ACTIONS=16
CS_TABLE_VERSIONS=2
CS_MAX_INPUT_TOKENS=32768
CS_MAX_LENGTH=32768
CS_MAX_NEW_TOKENS=256
# Distinct correction objects found exactly at a state, and the forward passes a state may take before the search
# stops and says so.
CS_TOP=5
CS_MAX_PASSES=96
# Two processes share a card from this much memory, as in the RL cell's evaluations.
CS_TWO_WORKERS_FROM_MIB=70000

cell_environment() {
  export PATH=/opt/slurm/bin:$PATH
  export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTHONPATH="$SRC"
  export TOKENIZERS_PARALLELISM=false WANDB_MODE=offline
  export HF_HOME HF_HUB_CACHE="$HF_HOME/hub" HF_DATASETS_CACHE="$HF_HOME/datasets" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}" PYTORCH_ALLOC_CONF=expandable_segments:True
  export RESEARCH_MAX_INPUT_TOKENS=$CS_MAX_INPUT_TOKENS RESEARCH_MAX_NEW_TOKENS=$CS_MAX_NEW_TOKENS
  export PSSE_LOCAL_DIAGNOSTIC_BUILD=1
  # Read at import time by modules the audit pulls in; it only has to name a known variant.
  export PSSE_EXPERT_VARIANT=baseline_compare
  unset PSSE_MULTI_SCAN_RCOND
}
