# Shared settings for the separate, frozen-input revised evaluation cell.
# Source this file; do not execute or reuse the old cell's stage functions.
set -euo pipefail
: "${REVISED_EVAL_ROOT:?Export the new, unique evaluation cell directory}"
REVISED_EVAL_ROOT=$(readlink -f -- "$REVISED_EVAL_ROOT")
OLD_PIPE=/scratch/yx3882/research_full_pipeline_20260921_physical
case "$REVISED_EVAL_ROOT" in
  "$OLD_PIPE"|"$OLD_PIPE"/*|/)
    printf 'Revised evaluation must use a separate cell: %s\n' "$REVISED_EVAL_ROOT" >&2
    return 2 ;;
esac
[[ "$REVISED_EVAL_ROOT" == /* && -d "$REVISED_EVAL_ROOT/source" ]] || {
  printf 'Missing staged source directory in %s\n' "$REVISED_EVAL_ROOT" >&2
  return 2
}

# Retain the original interpreter, model identity, token budgets and profile.
source "$OLD_PIPE/pipeline.env"
PIPE=$REVISED_EVAL_ROOT
SRC=$PIPE/source
OUT=$PIPE/out
LOGS=$PIPE/logs
D0_DIR=$OUT/d0
SUITE_DIR=$OUT/suite
BC0_DIR=$OUT/bc0
R1_DIR=$OUT/r1
R2_DIR=$OUT/r2
EXPERT_EVAL_DIR=$OUT/expert
R2_EVAL_DIR=$OUT/r2
FROZEN_SCENARIOS=$OLD_PIPE/out/r1/collection/development_scenarios.json
FROZEN_R2_ADAPTER=$OLD_PIPE/out/r2/training/lora
EXPERT_BASELINE=$OLD_PIPE/out/r1/collection/evaluation/expert_eval.json
# The legacy paired runner always calls its candidate file r1_eval.json.
R2_BASELINE=$OLD_PIPE/out/r2/collection/evaluation/r1_eval.json
# BC0 and R1 as scored in the round-1 paired evaluation (student bc0, candidate r1).
FROZEN_BC0_ADAPTER=$OLD_PIPE/out/bc0/lora
FROZEN_R1_ADAPTER=$OLD_PIPE/out/r1/training/lora
BC0_BASELINE=$OLD_PIPE/out/r1/collection/evaluation/bc0_eval.json
R1_BASELINE=$OLD_PIPE/out/r1/collection/evaluation/r1_eval.json
BC0_EVAL_DIR=$OUT/bc0
R1_EVAL_DIR=$OUT/r1
TEMPLATE_DIR=$SRC/research/hpc/revised_eval_20260922
pipeline_environment
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export REVISED_EVAL_ROOT SRC OUT LOGS PY TEST_PY
export MODEL_CHOICE MODEL_ID MODEL_REVISION SEED_ROUND EPISODE_MAX_STEPS
export NORMALIZED_RESIDUAL_THRESHOLD HIF_ALPHA_GRID HIF_R_GRID HIF_MAX_SCANS
mkdir -p "$OUT" "$LOGS"
[[ -s "$FROZEN_SCENARIOS" && -x "$PY" ]] || {
  printf 'Frozen scenarios or original runtime Python unavailable\n' >&2
  return 2
}

OPENDSS_LOCAL=
revised_eval_local_model() {
  [[ -f "$SRC/IEEE_14_OpenDSS/Run_IEEE14Bus.dss" ]] || return 2
  OPENDSS_LOCAL=$(mktemp -d "/dev/shm/psse_revised_eval_${SLURM_JOB_ID:-manual}.XXXXXXXX")
  cp -a -- "$SRC/IEEE_14_OpenDSS/." "$OPENDSS_LOCAL/"
  export PSSE_OPENDSS_MODEL_DIR="$OPENDSS_LOCAL"
}

revised_eval_cleanup() {
  local exit_status=$? resolved
  if [[ -n "${OPENDSS_LOCAL:-}" && -d "$OPENDSS_LOCAL" && ! -L "$OPENDSS_LOCAL" ]]; then
    resolved=$(readlink -f -- "$OPENDSS_LOCAL")
    if [[ "$resolved" == "$OPENDSS_LOCAL" && "$resolved" == /dev/shm/psse_revised_eval_* ]]; then
      rm -rf -- "$resolved"
    else
      printf 'Skipped cleanup of unexpected model path: %s\n' "$OPENDSS_LOCAL" >&2
    fi
  fi
  return "$exit_status"
}
