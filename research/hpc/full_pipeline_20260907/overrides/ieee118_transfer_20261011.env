# IEEE 118 transfer of the agentic system (2026-10-11): the balanced families and
# the waveform families (HIF, HIF with a bad meter, three-phase unbalance,
# harmonic; no topology), generated on IEEE 118 with the expert under the
# classifier-gated profile, then the frozen IEEE 14 student of the 2026-10-07
# classifier cell (its round-2 adapter) and the expert evaluated zero-shot on
# the IEEE 118 development roots.  The gate is the triage GNN trained on IEEE 14
# and IEEE 118 together (psse_env/oracle/models/triage_gnn_joint_20261011, one
# request threshold per network).  Sourced last by pipeline.env in the staged
# cell.  Deploy from Windows after uploading the corpora
# (output/classifier_triage_20261011/ieee118_pipeline_corpus/pipeline_corpus,
# 665 HIF and 289 unbalance windows, 460 MB) to $PIPE/corpora through ssh stdin:
#   PIPE=/scratch/yx3882/research_full_pipeline_20261011_ieee118
#   wsl -- ssh torch "mkdir -p $PIPE/corpora"
#   for f in hif_samples unbalance_samples; do
#     gzip -c output/classifier_triage_20261011/ieee118_pipeline_corpus/pipeline_corpus/$f.jsonl \
#       | wsl -- ssh torch "gunzip -c > $PIPE/corpora/$f.jsonl"
#   done   # then compare sha256sum on both sides
#   PIPE=$PIPE SOURCE_CELL=/scratch/yx3882/research_full_pipeline_20261007_classifier BASE=1003f7f \
#   BRANCH=codex/classifier-triage-20261004 OVERRIDES=ieee118_transfer_20261011.env \
#   SUBMIT_FROM= bash research/hpc/full_pipeline_20260907/deploy_cell_from_windows.sh <commit40>
# (BASE is the classifier cell's source commit, the last one its clone knows)
# and submit the chain d0 -> r1c -> zs (bc0 is the linked frozen adapter):
#   CHAIN="d0 r1c zs" bash submit_pipeline.sh
SYSTEM=case118
ADMISSION_MODE=recoverable
EVIDENCE_PROFILE=classifier_gated_diagnostics
HIF_SIGNATURE_MODE=discovered
EXPERT_VARIANT=baseline
# Global progress on the chi-square excess over the degrees of freedom: on
# IEEE 118 one correct meter repair of a multi-meter root removes 7-10% of the
# whole statistic (115 of 120 corpus roots have a repair under the halved 10%
# floor; 3 of 80 on IEEE 14) but 25-50% of the excess (4 of 120 under it).
PROGRESS_BASIS=chi_square_excess
# Fresh balanced corpus built by stage 0 under $OUT/corpus (the IEEE 57 and
# IEEE 118 balanced runs' sizes; one IEEE 118 WLS solve costs about a second).
CORPUS_COUNTS='{"no_error": 300, "measurement_error": 900, "parameter_error": 900}'
CORPUS_NUM_SCANS=3
# The waveform corpora's operating points are drawn at U(0.80, 1.25); the
# balanced corpus takes the same range.
CORPUS_LOAD_SCALE_MIN=0.80
CORPUS_LOAD_SCALE_MAX=1.25
# The waveform corpora of research/classifier_triage/ieee118_dataset
# (pipeline_corpus: admitted HIF and unbalance windows of the IEEE 118
# three-phase model at the AC-OPF dispatch, phasors at the PMU sigma 1e-4),
# uploaded beside the cell.  Harmonic roots are synthesized by the generator.
HIF_CORPUS_TRAIN=$PIPE/corpora/hif_samples.jsonl
HIF_CORPUS_VALID=
HIF_CORPUS_TRAIN_EXTRA=
HIF_CORPUS_VALID_EXTRA=
IMBALANCE_CORPUS=$PIPE/corpora/unbalance_samples.jsonl
# The joint IEEE 14 + 118 gate (residual_v2 view, thresholds 0.096 / 0.338).
TRIAGE_CLASSIFIER=$SRC/psse_env/oracle/models/triage_gnn_joint_20261011
# The expert aggregate of stage 0 (BC0 is not trained: the frozen adapter
# stands in), kept small; the suite builder draws the development roots
# outside it.  The nine non-topology families at the IEEE 14 development
# sizes, 124 roots.
D0_PLAN='{"no_error": 8, "measurement": 12, "multi_measurement": 10, "parameter": 12, "measurement+parameter": 12, "harmonic": 10, "hif": 10, "measurement+hif": 8, "three_phase_unbalance": 10}'
ROUND_TRAIN_PLAN='{"no_error": 2, "measurement": 3, "multi_measurement": 2, "parameter": 3, "measurement+parameter": 3, "harmonic": 3, "hif": 3, "measurement+hif": 2, "three_phase_unbalance": 3}'
DEVELOPMENT_PLAN='{"no_error": 8, "measurement": 16, "multi_measurement": 12, "parameter": 16, "measurement+parameter": 16, "harmonic": 16, "hif": 16, "measurement+hif": 8, "three_phase_unbalance": 16}'
# Student for round 1 and the zero-shot evaluation: the round-2 adapter of the
# 2026-10-07 classifier-gated cell (IEEE 14, same profile), linked as this
# run's bc0 by stage 0.
FROZEN_STUDENT_ADAPTER=/scratch/yx3882/research_full_pipeline_20261007_classifier/out/r2/training/lora
FROZEN_STUDENT_EVIDENCE_PROFILE=classifier_gated_diagnostics
ZEROSHOT_EVAL_NAME=zeroshot
PREVIOUS_PIPE=
