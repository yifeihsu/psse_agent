# Conventional-only confirmation cell (2026-10-22; docs/conventional_only_cell_20261022.md,
# docs/papers/pesgm2027 Section VI): the IEEE-14 pipeline restricted to the seven
# conventional families (bad analog data, single and multiple meters; line R/X errors;
# breaker-status errors on the node/breaker model; meter+R/X and meter+breaker; clean
# controls), trained and evaluated without any auxiliary tool and without the triage
# report, against a freshly drawn development set.
#
# Two conditions of the 2026-10-07 classifier cell (the source of the paper's Table I)
# are removed for every policy:
# * EVIDENCE_PROFILE=scada_only: the agent sees the balanced SCADA vector, its WLS and
#   the substation breaker telemetry the topology route reads; phasors, spectra, the
#   three-phase NLM, HSE and the HIF estimators are refused and absent from the tool
#   schemas (psse_env/evidence_profile.py SCADA_ALLOWED_TOOLS); no triage classifier
#   runs, so no triage report rides on any WLS solve.  compare_parameter_candidates
#   stays on the surface.
# * every plan names only the seven conventional families (the five waveform and
#   telemetry families are absent, i.e. zero: prerequisites.sh refuses zero entries).
# The teacher is baseline_compare (psse_env/oracle/expert_variants.py): the 2026-10-07
# cell's baseline expert plus the bounded candidate comparison before an ambiguous
# parameter correction; the ledger variants read the balanced screen, which scada_only
# does not run.  Everything is regenerated (D0, suites, BC0, both rounds).
#
# Matched to the 2026-10-07 cell: the per-family D0 and round counts of the
# conventional families, the 40-action horizon, recoverable admission, the 10-sigma
# meter floor, the parameter-ranking thresholds (training 1.2; development 1.0 with
# the true line within the top 2), the seeds of the aggregate (also the BC0 training
# seed) and of the rounds, and the training recipe (4-bit Gemma 4 12B, LoRA rank 16,
# BC0 one pass at 1e-4 with the best validation-loss checkpoint, rounds one pass at
# 3e-5 on the 1:1 mixture, beta 0.25).  The suite seed is new, so the development set
# is a fresh draw; build_suite.py keeps it disjoint by physical_root_fingerprint from
# this cell's D0 and round-collection roots, and the cell note records the check
# against the earlier development and hard-draw suites.  The development plan is
# twice the 96-root conventional cohort of the 2026-10-07 suite (8/16/12/16/16/16/12).
#
# Deploy and submit from Windows (SSH master up; ALLOW_PARALLEL_CHAIN because the
# comparison cell's fp- jobs may still be queued):
#   PIPE=/scratch/yx3882/research_full_pipeline_20261022_conventional \
#   SOURCE_CELL=/scratch/yx3882/research_full_pipeline_20261021_compare BASE=906374d \
#   BRANCH=claude/clever-roentgen-03b19c OVERRIDES=conventional_only_20261022.env ALLOW_PARALLEL_CHAIN=1 \
#   bash research/hpc/full_pipeline_20260907/deploy_cell_from_windows.sh <commit40>
# Chain: d0 (CPU) -> bc0 -> r1c -> r1t -> r1e -> r2c -> r2t -> r2e.  After stage 0:
#   check_suite_exclusion.py --reference-suite <earlier cells' aggregates and suites>.
EXPERT_VARIANT=baseline_compare
EVIDENCE_PROFILE=scada_only
HIF_SIGNATURE_MODE=discovered
PREVIOUS_PIPE=
FROZEN_STUDENT_ADAPTER=
TRIAGE_CLASSIFIER=
D0_PLAN='{"no_error": 30, "measurement": 60, "multi_measurement": 50, "parameter": 60, "topology": 60, "measurement+parameter": 60, "measurement+topology": 50}'
ROUND_TRAIN_PLAN='{"no_error": 6, "measurement": 12, "multi_measurement": 10, "parameter": 12, "topology": 12, "measurement+parameter": 12, "measurement+topology": 10}'
DEVELOPMENT_PLAN='{"no_error": 16, "measurement": 32, "multi_measurement": 24, "parameter": 32, "topology": 32, "measurement+parameter": 32, "measurement+topology": 24}'
# Fresh development draw (the 2026-10-01 and 2026-10-07 cells drew theirs with 20260911).
SEED_SUITE=20261022
SEED_D0=20260910
SEED_ROUND=20260912
EPISODE_MAX_STEPS=40
ADMISSION_MODE=recoverable
MEASUREMENT_ERROR_MIN_SIGMA=10
SUITE_TRAINING_THRESHOLD=1.2
SUITE_DEVELOPMENT_THRESHOLD=1.0
SUITE_DEVELOPMENT_RANK_ALLOWANCE=2
TOPOLOGY_EFFECTS=dangling_line_terminal,bus_split
BC0_LEARNING_RATE=1e-4
BC0_EPOCHS=1
ROUND_LEARNING_RATE=3e-5
COLLECTION_BETA=0.25
D1_SHARE=0.5
# An expert label the audit cannot verify ends its episode and is recorded
# (unverified_expert_labels in the collection report) instead of aborting the stage;
# the 2026-10-07 cell ran with abort and met none, so the two agree unless one occurs.
UNVERIFIED_EXPERT_LABEL_POLICY=stop

# Follow-ups after the chain (2026-10-23; submit_extras_20261023.sh, note section 6):
# the validation roots for the round selection (the 2026-10-07 classifier cell's
# development suite, conventional families only) and the hard-draw stress roots (the
# 2026-10-15 hard draw's development set, harmonic roots dropped); build_eval_suites.py
# removes any root of this cell's D0, rounds or test set.
EXTRA_VALIDATION_SOURCE=/scratch/yx3882/research_full_pipeline_20261007_classifier/out/suite/development.json
EXTRA_HARD_SOURCE=/scratch/yx3882/rl_pilot_20261014/data/hard_draw_20261015/hard_development.json
# The matched cloning control's fresh expert rows: an aggregate under the D0 settings with
# a new seed and the round-1 composition x3 (6/12/10/12/12/12/10 x 3, 222 roots).  The rows
# come from its balanced training view, which spreads rows nearly evenly over the families
# (D0's: 418 to 495 per fault family of 2,747); R1's collected rows need up to 126 of one
# family (multi_measurement), so x3 leaves about twice the rows each family needs.  The
# seed must not be one a draw of this cell used: 20261023 (SEED_SUITE + 1) is the test
# set's generator stream, and a local trial with it reproduced 3 of 32 test roots.
SEED_CONTROL=20261123
CONTROL_D0_PLAN='{"no_error": 18, "measurement": 36, "multi_measurement": 30, "parameter": 36, "topology": 36, "measurement+parameter": 36, "measurement+topology": 30}'
