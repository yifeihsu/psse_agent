# IEEE 118 balanced run (docs/ieee118_opendss_model_20260925.md): generate the
# five balanced families on IEEE 118 with the expert, same route as the IEEE 57
# transfer run (overrides/ieee57_transfer_20260914.env).  Sourced last by
# pipeline.env in the staged cell; deploy with
#   deploy_remote.sh BUNDLE BRANCH COMMIT /scratch/yx3882/<cell> ieee118_balanced_20260925.env
# For a zero-shot transfer of an earlier adapter set FROZEN_STUDENT_ADAPTER and
# submit CHAIN="d0 r1c zs"; with it empty the cell trains BC0 as usual.
SYSTEM=case118
ADMISSION_MODE=recoverable
# Fresh balanced corpus built by stage 0 under $OUT/corpus.  The 30-window
# IEEE 118 smoke admitted every AC-OPF window; sizes follow the IEEE 57 run.
CORPUS_COUNTS='{"no_error": 300, "measurement_error": 900, "parameter_error": 900}'
CORPUS_NUM_SCANS=3
# The five balanced families the registry supports, at the IEEE-14 run's sizes.
D0_PLAN='{"no_error": 30, "measurement": 60, "multi_measurement": 50, "parameter": 60, "measurement+parameter": 60}'
ROUND_TRAIN_PLAN='{"no_error": 6, "measurement": 12, "multi_measurement": 10, "parameter": 12, "measurement+parameter": 12}'
DEVELOPMENT_PLAN='{"no_error": 8, "measurement": 16, "multi_measurement": 12, "parameter": 16, "measurement+parameter": 16}'
# Detector stays the pipeline's (chi-square 0.01 OR normalized residual 4.0,
# threshold 962.58 at 863 degrees of freedom).  One IEEE 118 WLS fit costs
# ~1-1.5 s (1,098 channels), several times IEEE 57: expect a longer stage 0.
FROZEN_STUDENT_ADAPTER=
ZEROSHOT_EVAL_NAME=zeroshot
PREVIOUS_PIPE=
