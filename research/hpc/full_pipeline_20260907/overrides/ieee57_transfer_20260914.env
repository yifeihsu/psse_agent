# IEEE 57 transfer run (2026-09-14): generate the balanced IEEE 57 data with
# the expert, then evaluate the frozen 2026-09-12 IEEE-14 R2 adapter and the
# expert zero-shot on the IEEE 57 development roots.  Sourced last by
# pipeline.env in the staged cell; deploy with
#   deploy_remote.sh BUNDLE BRANCH COMMIT /scratch/yx3882/research_full_pipeline_20260914_ieee57 ieee57_transfer_20260914.env
# and submit the chain d0 -> r1c -> zs (bc0 is the linked frozen adapter):
#   CHAIN="d0 r1c zs" bash submit_pipeline.sh
SYSTEM=case57
ADMISSION_MODE=recoverable
# Fresh balanced corpus built by stage 0 under $OUT/corpus.  Sized for the
# plans below at the measured admission yields (single meter ~100%, parameter
# ~70%, mixed ~50% of attempts) after the train partition keeps four fifths.
CORPUS_COUNTS='{"no_error": 300, "measurement_error": 900, "parameter_error": 900}'
CORPUS_NUM_SCANS=3
# The five balanced families the IEEE 57 registry supports, at the IEEE-14
# run's per-family sizes.
D0_PLAN='{"no_error": 30, "measurement": 60, "multi_measurement": 50, "parameter": 60, "measurement+parameter": 60}'
ROUND_TRAIN_PLAN='{"no_error": 6, "measurement": 12, "multi_measurement": 10, "parameter": 12, "measurement+parameter": 12}'
DEVELOPMENT_PLAN='{"no_error": 8, "measurement": 16, "multi_measurement": 12, "parameter": 16, "measurement+parameter": 16}'
# The IEEE-14 detector settings are kept (alpha 0.01 plus the four-sigma
# residual test in pipeline.env); the IEEE 57 pilot's 0.05 pin is not used.
# Student for round 1 and the zero-shot evaluation: the final adapter of the
# 2026-09-12 node/breaker run (R2), linked as this run's bc0 by stage 0.
FROZEN_STUDENT_ADAPTER=/scratch/yx3882/research_full_pipeline_20260912/out/r2/training/lora
ZEROSHOT_EVAL_NAME=zeroshot
PREVIOUS_PIPE=
