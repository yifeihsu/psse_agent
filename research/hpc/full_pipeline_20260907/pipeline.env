# Full research pipeline (2026-09-07): expanded IEEE-14 suite, BC0 from the
# base model, then DAgger rounds 1 and 2.  Sourced by every stage script.
# Paths are rewritten by deploy_remote.sh when the cell is staged elsewhere.
PIPE=/scratch/yx3882/research_full_pipeline_20260912
SRC=$PIPE/source
OUT=$PIPE/out
LOGS=$PIPE/logs
PY=/scratch/yx3882/.conda/envs/gemma4_research_5104/bin/python
TEST_PY=/scratch/yx3882/envs/dagger12b_overlay/bin/python
EXPECTED_SOURCE_COMMIT_FILE=$PIPE/source_commit.txt
HF_HOME=/scratch/yx3882/.cache/huggingface
MODEL_CHOICE=12b
MODEL_ID=google/gemma-4-12B-it
MODEL_REVISION=707f0a3b8a3c7ad586ed01e27eafbad8a27dd0f7

# A previous run whose expert aggregate and BC0 are reused: stage 0 links
# its D0 and stage 1 links its BC0 instead of regenerating them, so a suite
# or teacher change re-runs only the DAgger rounds.  Empty disables reuse.
PREVIOUS_PIPE=

# Stage directories.
D0_DIR=$OUT/d0
SUITE_DIR=$OUT/suite
BC0_DIR=$OUT/bc0
R1_DIR=$OUT/r1
R2_DIR=$OUT/r2

# Protected roots: the frozen BC0 evaluation suite and the 27-row trace
# validation set stay out of every generated scenario.
BC0_SUITE=$SRC/psse_env/dagger/suites/bc0_eval_suite_v1.json
TRACE_VALIDATION=/scratch/yx3882/research_dagger_trace_20260823/trace_validation.jsonl

# Corpora (branch-current telemetry for HIF and unbalance; the tabular corpus
# for the classical families and harmonics).
HIF_CORPUS_TRAIN=$SRC/artifacts/measurements/hif_multiscan_currents_train_85x10_20260903/samples.jsonl
HIF_CORPUS_VALID=$SRC/artifacts/measurements/hif_multiscan_currents_17x10_20260903/samples.jsonl
IMBALANCE_CORPUS=$SRC/artifacts/measurements/out_measurements_imbalance_currents_20260903/samples.jsonl

# Seeds: the expert aggregate, the DAgger suite, and the collection/evaluation
# draws are independent streams.
SEED_D0=20260910
SEED_SUITE=20260911
SEED_ROUND=20260912

# Root plans.  D0 is the expert-only aggregate that trains BC0; the suite
# plans are per DAgger round (rounds 1 and 2 draw disjoint roots) and for the
# shared development set that every evaluation uses.  Capacities: 102 HIF
# windows shared by hif and measurement+hif, 220 unbalance rows also feeding
# the balanced control, and the train partition (four fifths) of the tabular
# corpus for the rest.
D0_PLAN='{"no_error": 30, "measurement": 60, "multi_measurement": 50, "parameter": 60, "topology": 60, "harmonic": 50, "hif": 38, "measurement+parameter": 60, "measurement+topology": 50, "measurement+hif": 20, "three_phase_unbalance": 50, "telemetry_no_disturbance": 20}'
ROUND_TRAIN_PLAN='{"no_error": 6, "measurement": 12, "multi_measurement": 10, "parameter": 12, "topology": 12, "harmonic": 12, "hif": 12, "measurement+parameter": 12, "measurement+topology": 10, "measurement+hif": 6, "three_phase_unbalance": 12, "telemetry_no_disturbance": 6}'
DEVELOPMENT_PLAN='{"no_error": 8, "measurement": 16, "multi_measurement": 12, "parameter": 16, "topology": 16, "harmonic": 16, "hif": 16, "measurement+parameter": 16, "measurement+topology": 12, "measurement+hif": 8, "three_phase_unbalance": 16, "telemetry_no_disturbance": 8}'
DAGGER_ROUNDS=2
CANDIDATE_MULTIPLIER=3
# Training and collection roots are drawn at the production parameter-ranking
# threshold (teacher-solvable on the first pass); the development set is
# drawn at the detection threshold with the true line allowed anywhere within
# the ambiguity allowance, and each root records its stratum.
SUITE_TRAINING_THRESHOLD=1.2
SUITE_DEVELOPMENT_THRESHOLD=1.0
SUITE_DEVELOPMENT_RANK_ALLOWANCE=2
# Every injected meter error (corpus rows and composed overlays) is lifted to
# at least this many noise sigmas before admission, in D0 and in the suite.
MEASUREMENT_ERROR_MIN_SIGMA=10
# Topology roots are breaker-status errors in the full IEEE-14 node/breaker
# model with substation telemetry (docs/ieee14_node_breaker_nlm_20260912.md):
# a switch that isolates one line terminal, or one that splits a bus.  The
# 10/14 merge is supported but residual-dominant on the operator model and
# stays out.  Passed to the aggregate and both suite draws.
TOPOLOGY_EFFECTS=dangling_line_terminal,bus_split

# Expert aggregate (round 0).  The 2026-09-07 aggregate was built at 24
# steps (one multi-meter expert episode reached that cap); the production
# horizon is 40 and applies to any aggregate built after that date.
D0_COUNTERFACTUALS=3
D0_MAX_STEPS=40
HIF_ALPHA_GRID=7
HIF_R_GRID=9
HIF_MAX_SCANS=10

# BC0 from the base model: the full-BC0 recipe (lr 1e-4, one pass, LoRA rank
# 16, micro-batch 1 x 4 accumulation) with the best validation-loss
# checkpoint kept.  Rounds continue the previous adapter for one pass at
# 3e-5 on the 1:1 mixture and keep the final adapter.
BC0_LEARNING_RATE=1e-4
BC0_EPOCHS=1
BC0_SAVE_EVAL_STEPS=64
# Family-stratified subset of the D0 validation split used as the loss monitor.
VALIDATION_ROWS=128
ROUND_LEARNING_RATE=3e-5
ROUND_SAVE_EVAL_STEPS=16
TRAIN_MAX_LENGTH=32768

# Collection and evaluation.  The evaluation budget is the production
# 40-step horizon; a multi-meter root corrected one meter per commit needs
# about six steps per meter, so 24 could not hold four or five meters.
COLLECTION_BETA=0.25
COLLECTION_MAX_STEPS=12
EVAL_MAX_STEPS=40
D1_CAP=100000
D1_SHARE=0.5

pipeline_environment() {
  export PYTHONDONTWRITEBYTECODE=1
  export PYTHONNOUSERSITE=1
  export PYTHONUNBUFFERED=1
  export PYTHONPATH="$SRC"
  export TOKENIZERS_PARALLELISM=false
  export WANDB_MODE=offline
  export HF_HOME
  export HF_HUB_CACHE="$HF_HOME/hub"
  export HF_DATASETS_CACHE="$HF_HOME/datasets"
  export HF_HUB_OFFLINE=1
  export TRANSFORMERS_OFFLINE=1
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
  export PYTORCH_ALLOC_CONF=expandable_segments:True
  export RESEARCH_MAX_INPUT_TOKENS=32768
  export RESEARCH_MAX_NEW_TOKENS=256
  # The multi-scan HIF search runs across the allocated CPUs.
  export PSSE_HIF_WORKERS="${SLURM_CPUS_PER_TASK:-8}"
  # The research environment does not carry the release numerical pins; the
  # aggregate records the deviation instead of refusing to build.
  export PSSE_LOCAL_DIAGNOSTIC_BUILD=1
}

# Reuse a finished stage from PREVIOUS_PIPE: link its directory and copy its
# receipt when this run has neither.  Prints what it did.
reuse_previous_stage() {
  local subdir=$1 receipt=$2
  [[ -n "$PREVIOUS_PIPE" && -d "$PREVIOUS_PIPE/out/$subdir" && -s "$PREVIOUS_PIPE/out/$receipt" ]] || return 0
  if [[ ! -e "$OUT/$subdir" && ! -s "$OUT/$receipt" ]]; then
    ln -s "$PREVIOUS_PIPE/out/$subdir" "$OUT/$subdir"
    cp "$PREVIOUS_PIPE/out/$receipt" "$OUT/$receipt"
    echo "[reuse] $subdir and $receipt taken from $PREVIOUS_PIPE"
  fi
}

# Copy the OpenDSS model to node-local memory so the HIF search does not
# re-read it from the shared filesystem on every candidate simulation.
opendss_local_model() {
  OPENDSS_LOCAL=/dev/shm/psse_opendss_${SLURM_JOB_ID:-manual}
  rm -rf "$OPENDSS_LOCAL" && cp -r "$SRC/IEEE_14_OpenDSS" "$OPENDSS_LOCAL"
  export PSSE_OPENDSS_MODEL_DIR="$OPENDSS_LOCAL"
}

# Per-round bindings: the student that collects, the pool it mixes with, the
# suite it rolls out on, and where the round writes.
round_bindings() {
  local round=$1
  case "$round" in
    r1)
      ROUND_DIR=$R1_DIR
      STUDENT=$BC0_DIR/lora
      POOL_RAW=$D0_DIR/aggregate.raw.jsonl
      POOL_TRAIN=$D0_DIR/aggregate.train_view.jsonl
      TRAINING_SUITE=$SUITE_DIR/r1_training.json
      ;;
    r2)
      ROUND_DIR=$R2_DIR
      STUDENT=$R1_DIR/training/lora
      POOL_RAW=$R2_DIR/pool/raw.jsonl
      POOL_TRAIN=$R2_DIR/pool/train.jsonl
      TRAINING_SUITE=$SUITE_DIR/r2_training.json
      ;;
    *) echo "unknown pipeline round: $round" >&2; return 2 ;;
  esac
  DEVELOPMENT_SUITE=$SUITE_DIR/development.json
  COLLECTION_DIR=$ROUND_DIR/collection
  TRAIN_DIR=$ROUND_DIR/training
  CANDIDATE=$TRAIN_DIR/lora
  VALIDATION=$D0_DIR/aggregate.validation.jsonl
}

# The research-script invocation for a round.  Collection and evaluation must
# pass identical arguments; evaluation only appends --eval-r1-adapter.
collection_args() {
  local round=$1
  round_bindings "$round"
  COLLECTION_ARGS=(
    --d0-raw "$POOL_RAW"
    --d0-train "$POOL_TRAIN"
    --protected-suite "$BC0_SUITE"
    --adapter-path "$STUDENT"
    --output-dir "$COLLECTION_DIR"
    --model-choice "$MODEL_CHOICE"
    --seed "$SEED_ROUND"
    --beta "$COLLECTION_BETA"
    --max-steps "$COLLECTION_MAX_STEPS"
    --d1-cap "$D1_CAP"
    --d1-share "$D1_SHARE"
    --training-scenarios "$TRAINING_SUITE"
    --development-scenarios "$DEVELOPMENT_SUITE"
    --hif-search-profile research
    --eval-max-steps "$EVAL_MAX_STEPS"
  )
  if [[ -s "$TRACE_VALIDATION" ]]; then
    COLLECTION_ARGS+=(--protected-suite "$TRACE_VALIDATION")
  fi
}

if [[ -f "$PIPE/pipeline.overrides.env" ]]; then
  # shellcheck source=/dev/null
  source "$PIPE/pipeline.overrides.env"
fi
