# Full research pipeline (2026-09-07): expanded IEEE-14 suite, BC0 from the
# base model, then DAgger rounds 1 and 2.  Sourced by every stage script.
# Paths are rewritten by deploy_remote.sh when the cell is staged elsewhere.
PIPE=/scratch/yx3882/research_full_pipeline_20260912
SRC=$PIPE/source
OUT=$PIPE/out
LOGS=$PIPE/logs
PY=/scratch/yx3882/.conda/envs/gemma4_research_5104/bin/python
TEST_PY=/scratch/yx3882/envs/dagger12b_overlay/bin/python
EXPECTED_SOURCE_COMMIT_FILE=$PIPE/source_commit.txt
HF_HOME=/scratch/yx3882/.cache/huggingface
MODEL_CHOICE=12b
MODEL_ID=google/gemma-4-12B-it
MODEL_REVISION=707f0a3b8a3c7ad586ed01e27eafbad8a27dd0f7

# A previous run whose expert aggregate and BC0 are reused: stage 0 links
# its D0 and stage 1 links its BC0 instead of regenerating them, so a suite
# or teacher change re-runs only the DAgger rounds.  Empty disables reuse.
PREVIOUS_PIPE=

# Stage directories.
D0_DIR=$OUT/d0
SUITE_DIR=$OUT/suite
BC0_DIR=$OUT/bc0
R1_DIR=$OUT/r1
R2_DIR=$OUT/r2

# Protected roots: the frozen BC0 evaluation suite and the 27-row trace
# validation set stay out of every generated scenario.
BC0_SUITE=$SRC/psse_env/dagger/suites/bc0_eval_suite_v1.json
TRACE_VALIDATION=/scratch/yx3882/research_dagger_trace_20260823/trace_validation.jsonl

# Corpora (branch-current telemetry for HIF and unbalance; the tabular corpus
# for the classical families and harmonics).  The HIF corpora are the
# 2026-09-19 physical-ohm regeneration of the legacy OpenDSS stack
# (docs/ieee14_hif_legacy_reconfiguration_20260919.md): fault resistance is
# drawn in ohms on the faulted line's local base in the bands 100-200,
# 200-500 and 500-1000 ohm at weights 1:1:1, on the seven 69 kV lines only
# (2.10-21.00 pu under the voltage profile ieee14_nominal_69_13p8_18kv_v1),
# and the injections follow the WLS shunt convention (shunt_convention ybus).
# The 20260903 corpora they replace are system-pu (20-200 pu) legacy artifacts
# whose every window alarmed the WLS through the bus-9 capacitor double count.
# 2026-09-21 cell: only DETECTABLE windows are used as corpora (discovered-mode WLS
# admission at margin 1.25, reference scan; see output/hif_physical_revision_20260921/
# *_ztrue audits). The full corpora keep the same names without `_detectable`.
# 2026-09-23 (suffix b): the same windows re-simulated with generator reactive
# limits kept (apply_hif_operating_point no longer lets the kW write reset
# Maxkvar/Minkvar, so PV buses regulate and bus 8 injects reactive power) and
# with the OpenDSS solve tolerance tightened to 1e-8 in Run_IEEE14Bus.dss, so
# every corpus is the converged power flow of its operating point; 131
# admitted windows.
HIF_CORPUS_TRAIN=$SRC/artifacts/measurements/hif_physical69_main_train_detectable_27x10_20260923b/samples.jsonl
HIF_CORPUS_VALID=$SRC/artifacts/measurements/hif_physical69_main_valid_detectable_8x10_20260923b/samples.jsonl
# 2026-09-21 expansion: same recipe (69 kV lines, 100-200/200-500/500-1000 ohm
# bands, weights 1:1:1, shunt_convention ybus), independent seeds 20260923 and
# 20260924, so the discovered-mode admitted pool clears the 78-window plan.
HIF_CORPUS_TRAIN_EXTRA=$SRC/artifacts/measurements/hif_physical69_main_train_extra_detectable_77x10_20260923b/samples.jsonl
HIF_CORPUS_VALID_EXTRA=$SRC/artifacts/measurements/hif_physical69_main_valid_extra_detectable_19x10_20260923b/samples.jsonl
# 2026-09-21: the unbalance corpus is regenerated under the WLS shunt convention
# (shunt_convention ybus; the 20260903 corpus counted the bus-9 capacitor in Qinj
# and every one of its rows alarmed the WLS for that reason). Vm is the phase-A
# magnitude by decision; telemetry bases follow ieee14_nominal_69_13p8_18kv_v1.
# 2026-09-23 (suffix b): same seed, re-solved at tolerance 1e-8 like the HIF
# corpora, so the two generators' balanced solves agree; 160 admitted windows.
IMBALANCE_CORPUS=$SRC/artifacts/measurements/out_measurements_imbalance_currents_ybus_detectable_160_20260923b/samples.jsonl

# Seeds: the expert aggregate, the DAgger suite, and the collection/evaluation
# draws are independent streams.
SEED_D0=20260910
SEED_SUITE=20260911
SEED_ROUND=20260912

# Root plans.  D0 is the expert-only aggregate that trains BC0; the suite
# plans are per DAgger round (rounds 1 and 2 draw disjoint roots) and for the
# shared development set that every evaluation uses.  Capacities: 131 HIF
# windows (27 + 77 train, 8 + 19 validation; every one passes discovered-mode
# admission) shared by hif and measurement+hif (the plans below use
# 38+2x12+16 = 78 and 20+2x6+8 = 40 of them), 160 unbalance windows (all
# admitted) also feeding the balanced control, and the train partition (four
# fifths) of the tabular corpus for the rest.
# Audit 2026-09-20: of the original 105 windows only 25/84 train + 7/21
# validation passed discovered-mode admission at margin 1.25, below D0's 38
# pure HIF roots. The 2026-09-21 expansion adds 315 windows of the same
# population instead of relaxing admission; the admitted counts of the
# expanded pool are recorded in docs/ieee14_hif_legacy_reconfiguration_20260919.md.
D0_PLAN='{"no_error": 30, "measurement": 60, "multi_measurement": 50, "parameter": 60, "topology": 60, "harmonic": 50, "hif": 38, "measurement+parameter": 60, "measurement+topology": 50, "measurement+hif": 20, "three_phase_unbalance": 50, "telemetry_no_disturbance": 20}'
ROUND_TRAIN_PLAN='{"no_error": 6, "measurement": 12, "multi_measurement": 10, "parameter": 12, "topology": 12, "harmonic": 12, "hif": 12, "measurement+parameter": 12, "measurement+topology": 10, "measurement+hif": 6, "three_phase_unbalance": 12, "telemetry_no_disturbance": 6}'
DEVELOPMENT_PLAN='{"no_error": 8, "measurement": 16, "multi_measurement": 12, "parameter": 16, "topology": 16, "harmonic": 16, "hif": 16, "measurement+parameter": 16, "measurement+topology": 12, "measurement+hif": 8, "three_phase_unbalance": 16, "telemetry_no_disturbance": 8}'
DAGGER_ROUNDS=2
CANDIDATE_MULTIPLIER=3
# Training and collection roots are drawn at the production parameter-ranking
# threshold (teacher-solvable on the first pass); the development set is
# drawn at the detection threshold with the true line allowed anywhere within
# the ambiguity allowance, and each root records its stratum.
SUITE_TRAINING_THRESHOLD=1.2
SUITE_DEVELOPMENT_THRESHOLD=1.0
SUITE_DEVELOPMENT_RANK_ALLOWANCE=2
# Every injected meter error (corpus rows and composed overlays) is lifted to
# at least this many noise sigmas before admission, in D0 and in the suite.
MEASUREMENT_ERROR_MIN_SIGMA=10
# Topology roots are breaker-status errors in the full IEEE-14 node/breaker
# model with substation telemetry (docs/ieee14_node_breaker_nlm_20260912.md):
# a switch that isolates one line terminal, or one that splits a bus.  The
# 10/14 merge is supported but residual-dominant on the operator model and
# stays out.  Passed to the aggregate and both suite draws.
TOPOLOGY_EFFECTS=dangling_line_terminal,bus_split

# System under study.  case14 is the IEEE-14 pipeline above.  case57 runs the
# five balanced families of psse_env/systems/registry.py only: point
# MEASUREMENT_CORPUS and BALANCED_ARTIFACT_DIR at a fresh balanced corpus
# (psse_env.providers.balanced_corpus.build_balanced_corpus), restrict every
# plan to those families, and the waveform corpora above are not passed.
# ADMISSION_MODE recoverable keeps the teacher-solvable draw of the IEEE-14
# runs; physical keeps every solved operating window.
SYSTEM=case14
# New runs use only the case, balanced SCADA and its declared covariance.
# Reproducing an old sensor-assisted run requires an explicit override.
EVIDENCE_PROFILE=${EVIDENCE_PROFILE:-scada_only}
HIF_SIGNATURE_MODE=${HIF_SIGNATURE_MODE:-discovered}
MEASUREMENT_CORPUS=
BALANCED_ARTIFACT_DIR=
ADMISSION_MODE=recoverable
# A non-IEEE14 system with MEASUREMENT_CORPUS empty gets its corpus built by
# stage 0 under $OUT/corpus (scripts/build_balanced_corpus.py) with these
# rows per corpus scenario and scans per parameter window.
CORPUS_COUNTS='{"no_error": 300, "measurement_error": 900, "parameter_error": 900}'
CORPUS_NUM_SCANS=3
# A finished adapter from an earlier run to use as this run's student: stage
# 0 links it as bc0 with a receipt, so stage 1 trains nothing and round 1
# collects with it.  Empty trains BC0 from the base model as before.
FROZEN_STUDENT_ADAPTER=
# Required for strict reuse; absent legacy declarations mean auxiliary data.
FROZEN_STUDENT_EVIDENCE_PROFILE=
# Output name of the zero-shot evaluation (stage_zeroshot.sbatch): the
# round-1 student and the expert on the development roots, no candidate.
ZEROSHOT_EVAL_NAME=zeroshot

# WLS anomaly detector for both systems, in scenario admission (stage 0) and
# in the collection/evaluation environment: chi-square at alpha 0.01 OR a
# maximum normalized residual at this threshold.  Chosen 2026-09-14 on fresh
# clean windows of both networks (3 sigma flagged 63%/30% of healthy IEEE 57
# and IEEE 14 windows, 3.5 sigma 22%/6%, 4 sigma 5%/2%; every ten-sigma meter
# fault is caught at any of them).  Runs before this date used the
# chi-square-only detector.
NORMALIZED_RESIDUAL_THRESHOLD=4.0

# Expert aggregate (round 0).  The 2026-09-07 aggregate was built at 24
# steps (one multi-meter expert episode reached that cap); the production
# horizon is 40 and applies to any aggregate built after that date.
D0_COUNTERFACTUALS=3
EPISODE_MAX_STEPS=${EPISODE_MAX_STEPS:-40}
D0_MAX_STEPS="$EPISODE_MAX_STEPS"
HIF_ALPHA_GRID=7
HIF_R_GRID=9
HIF_MAX_SCANS=10

# BC0 from the base model: the full-BC0 recipe (lr 1e-4, one pass, LoRA rank
# 16, micro-batch 1 x 4 accumulation) with the best validation-loss
# checkpoint kept.  Rounds continue the previous adapter for one pass at
# 3e-5 on the 1:1 mixture and keep the final adapter.
BC0_LEARNING_RATE=1e-4
BC0_EPOCHS=1
BC0_SAVE_EVAL_STEPS=64
# Family-stratified subset of the D0 validation split used as the loss monitor.
VALIDATION_ROWS=128
ROUND_LEARNING_RATE=3e-5
ROUND_SAVE_EVAL_STEPS=16
TRAIN_MAX_LENGTH=32768

# Collection and evaluation.  The evaluation budget is the production
# 40-step horizon; a multi-meter root corrected one meter per commit needs
# about six steps per meter, so 24 could not hold four or five meters.
COLLECTION_BETA=0.25
COLLECTION_MAX_STEPS="$EPISODE_MAX_STEPS"
EVAL_MAX_STEPS="$EPISODE_MAX_STEPS"
D1_CAP=100000
D1_SHARE=0.5

pipeline_environment() {
  case "$EVIDENCE_PROFILE" in scada_only|auxiliary_diagnostics) ;; *) echo "unknown evidence profile: $EVIDENCE_PROFILE" >&2; return 2 ;; esac
  if [[ "$EVIDENCE_PROFILE" == scada_only && "$HIF_SIGNATURE_MODE" != discovered ]]; then
    echo "SCADA-only generation requires discovered waveform signatures" >&2; return 2
  fi
  for receipt in "$OUT/d0.done" "$OUT/suite.done" "$OUT/bc0.done"; do
    if [[ -s "$receipt" ]]; then assert_stage_evidence_profile "$receipt"; fi
  done
  export PYTHONDONTWRITEBYTECODE=1
  export PYTHONNOUSERSITE=1
  export PYTHONUNBUFFERED=1
  export PYTHONPATH="$SRC"
  export TOKENIZERS_PARALLELISM=false
  export WANDB_MODE=offline
  export HF_HOME
  export HF_HUB_CACHE="$HF_HOME/hub"
  export HF_DATASETS_CACHE="$HF_HOME/datasets"
  export HF_HUB_OFFLINE=1
  export TRANSFORMERS_OFFLINE=1
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
  export PYTORCH_ALLOC_CONF=expandable_segments:True
  export RESEARCH_MAX_INPUT_TOKENS=32768
  export RESEARCH_MAX_NEW_TOKENS=256
  # The multi-scan HIF search runs across the allocated CPUs.
  export PSSE_HIF_WORKERS="${SLURM_CPUS_PER_TASK:-8}"
  # The research environment does not carry the release numerical pins; the
  # aggregate records the deviation instead of refusing to build.
  export PSSE_LOCAL_DIAGNOSTIC_BUILD=1
}

# Reuse a finished stage from PREVIOUS_PIPE: link its directory and copy its
# receipt when this run has neither.  Prints what it did.
assert_stage_evidence_profile() {
  "$PY" - "$1" "$EVIDENCE_PROFILE" <<'PY'
import json
import sys
from pathlib import Path
receipt = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
declared = receipt.get("evidence_profile") or (receipt.get("research_profile") or {}).get("evidence_profile")
# Undeclared archives are historical auxiliary runs, never new SCADA-only data.
declared = declared or "auxiliary_diagnostics"
if declared != sys.argv[2]:
    raise SystemExit(f"Evidence-profile mismatch for {sys.argv[1]}: {declared} != {sys.argv[2]}; generate a fresh compatible stage.")
PY
}

reuse_previous_stage() {
  local subdir=$1 receipt=$2
  [[ -n "$PREVIOUS_PIPE" && -d "$PREVIOUS_PIPE/out/$subdir" && -s "$PREVIOUS_PIPE/out/$receipt" ]] || return 0
  if [[ ! -e "$OUT/$subdir" && ! -s "$OUT/$receipt" ]]; then
    assert_stage_evidence_profile "$PREVIOUS_PIPE/out/$receipt"
    ln -s "$PREVIOUS_PIPE/out/$subdir" "$OUT/$subdir"
    cp "$PREVIOUS_PIPE/out/$receipt" "$OUT/$receipt"
    echo "[reuse] $subdir and $receipt taken from $PREVIOUS_PIPE"
  fi
}

# Copy the OpenDSS model to node-local memory so the HIF search does not
# re-read it from the shared filesystem on every candidate simulation.
opendss_local_model() {
  OPENDSS_LOCAL=/dev/shm/psse_opendss_${SLURM_JOB_ID:-manual}
  rm -rf "$OPENDSS_LOCAL" && cp -r "$SRC/IEEE_14_OpenDSS" "$OPENDSS_LOCAL"
  export PSSE_OPENDSS_MODEL_DIR="$OPENDSS_LOCAL"
}

# Per-round bindings: the student that collects, the pool it mixes with, the
# suite it rolls out on, and where the round writes.
round_bindings() {
  local round=$1
  case "$round" in
    r1)
      ROUND_DIR=$R1_DIR
      STUDENT=$BC0_DIR/lora
      POOL_RAW=$D0_DIR/aggregate.raw.jsonl
      POOL_TRAIN=$D0_DIR/aggregate.train_view.jsonl
      TRAINING_SUITE=$SUITE_DIR/r1_training.json
      ;;
    r2)
      ROUND_DIR=$R2_DIR
      STUDENT=$R1_DIR/training/lora
      POOL_RAW=$R2_DIR/pool/raw.jsonl
      POOL_TRAIN=$R2_DIR/pool/train.jsonl
      TRAINING_SUITE=$SUITE_DIR/r2_training.json
      ;;
    *) echo "unknown pipeline round: $round" >&2; return 2 ;;
  esac
  DEVELOPMENT_SUITE=$SUITE_DIR/development.json
  COLLECTION_DIR=$ROUND_DIR/collection
  TRAIN_DIR=$ROUND_DIR/training
  CANDIDATE=$TRAIN_DIR/lora
  VALIDATION=$D0_DIR/aggregate.validation.jsonl
}

# The research-script invocation for a round.  Collection and evaluation must
# pass identical arguments; evaluation only appends --eval-r1-adapter.
collection_args() {
  local round=$1
  round_bindings "$round"
  COLLECTION_ARGS=(
    --evidence-profile "$EVIDENCE_PROFILE"
    --hif-signature-mode "$HIF_SIGNATURE_MODE"
    --d0-raw "$POOL_RAW"
    --d0-train "$POOL_TRAIN"
    --protected-suite "$BC0_SUITE"
    --adapter-path "$STUDENT"
    --output-dir "$COLLECTION_DIR"
    --model-choice "$MODEL_CHOICE"
    --seed "$SEED_ROUND"
    --beta "$COLLECTION_BETA"
    --max-steps "$COLLECTION_MAX_STEPS"
    --d1-cap "$D1_CAP"
    --d1-share "$D1_SHARE"
    --training-scenarios "$TRAINING_SUITE"
    --development-scenarios "$DEVELOPMENT_SUITE"
    --hif-search-profile research
    --eval-max-steps "$EVAL_MAX_STEPS"
    --normalized-residual-threshold "$NORMALIZED_RESIDUAL_THRESHOLD"
  )
  if [[ "$SYSTEM" == case14 ]]; then
    # The roots come from the fixed suites; naming the corpora here makes the
    # recorded research_profile state which HIF windows they were drawn from
    # instead of the research runner's legacy default.
    COLLECTION_ARGS+=(--hif-sample-paths "$HIF_CORPUS_TRAIN" "$HIF_CORPUS_VALID" "$HIF_CORPUS_TRAIN_EXTRA" "$HIF_CORPUS_VALID_EXTRA")
    COLLECTION_ARGS+=(--imbalance-sample-path "$IMBALANCE_CORPUS")
  fi
  if [[ -s "$TRACE_VALIDATION" ]]; then
    COLLECTION_ARGS+=(--protected-suite "$TRACE_VALIDATION")
  fi
}

if [[ -f "$PIPE/pipeline.overrides.env" ]]; then
  # shellcheck source=/dev/null
  source "$PIPE/pipeline.overrides.env"
fi

# Episode stages share one configured horizon even after legacy overrides.
# Change EPISODE_MAX_STEPS to override all stages together.
D0_MAX_STEPS="$EPISODE_MAX_STEPS"
COLLECTION_MAX_STEPS="$EPISODE_MAX_STEPS"
EVAL_MAX_STEPS="$EPISODE_MAX_STEPS"
